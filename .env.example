# Clouds8 - Environment Configuration

# === Web Server Settings ===
# Enable debug mode for development (true/false)
CLOUDS8_DEBUG=true

# Port to run the web server on
CLOUDS8_PORT=8050

# Host address to bind to (use 0.0.0.0 for external access)
CLOUDS8_HOST=127.0.0.1

# === Database Service ===
# Base URL of the standalone DB service (services/db-service/). It is the
# only process that opens clouds8.db directly - everything else talks to it
# over HTTP, either via db/database.py's facade (sync.py, seed_data.py,
# services/backend-api/) or shared/client/db_client.py (Dash UI, future CLI).
# Run it with: cd services/db-service && uvicorn app:app --port 8001
DB_SERVICE_URL=http://localhost:8001

# Path to the SQLite file, read only by the DB service itself.
# CLOUDS8_DB_PATH=/absolute/path/to/clouds8.db

# === Backend API Service ===
# Base URL of the cloud-provider-wrapper service (services/backend-api/) -
# collectors, scanners, sync/scan/probe job triggers.
# Run it with: cd services/backend-api && uvicorn app:app --port 8002
BACKEND_API_URL=http://localhost:8002

# === Authentication (admin/password, no 2FA) ===
# See docs/superpowers/specs/2026-10-04-admin-auth-design.md.
# Single hardcoded admin credential - no multi-user accounts.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Random secret used to sign/verify session tokens. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=replace-with-random-hex

# Shared secret for server-to-server calls (Dash UI, lynxctl, sync.py,
# seed_data.py, backend-api's internal calls to db-service). Generate the
# same way as AUTH_SECRET, with a different value.
INTERNAL_SERVICE_TOKEN=replace-with-random-hex
